# Server
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Postgres. Render, Neon or Supabase all work.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/remitsure

# Stellar
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
REMITSURE_CONTRACT_ID=CBMGPXSBSDKU55QGZTILUOZLUB5IBVBQ2YLJPXDYYCR6CXV42W7LABKF

# Indexer
# Run the indexer inside the API process. Handy on a single free Render instance.
INDEXER_ENABLED=true
INDEXER_POLL_MS=5000
# Ledger to start from on first run. Leave empty to start from the latest ledger.
INDEXER_START_LEDGER=5456200
